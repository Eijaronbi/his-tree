# Secrets: once pushed, it takes a rewrite to get them out.
.env
.env.*
!.env.example
*.pem

# Builds and what they need. Builds go in a release, with pch publish, not in the repo.
# A leading slash means at the top only, so a source folder with the same name further down stays.
/dist/
/build/
/out/
/target/
/bin/Debug/
/bin/Release/
/obj/
node_modules/
__pycache__/
.venv/

# Godot
.godot/

# Unity
/[Ll]ibrary/
/[Tt]emp/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# Unreal
/Binaries/
/Intermediate/
/Saved/
/DerivedData/

# Gradle, for Minecraft mods
.gradle/
/run/

# Blender's backups
*.blend1
*.blend2

# Editors and systems
.idea/
.DS_Store
Thumbs.db
*.log

# HIS-TREE specific
# Source archives of generated models: the .glb is committed, the .zip is not.
/assets/models/generated/*.zip
# Pipeline output and local scratch
/tools/out/
/tools/renders/
/tools/glb/
/tools/q2/
/tools/q3/
/tools/unz/
/tools/tex/
# Credentials are never in the repo; they live in /data/home/.config/
*.key
api_key
# Large generated videos are produced on demand, not stored
/assets/cinematics/*.webm

# Local progress gallery (dev only, not part of the build)
/gallery/
